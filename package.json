{
  "name": "dsh-response-chime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A DeepSeek Harness plugin that chimes when an agent finishes answering, with a switch in the left sidebar to turn it off.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevTarlow/dsh-response-chime.git"
  },
  "homepage": "https://github.com/DevTarlow/dsh-response-chime#readme",
  "bugs": {
    "url": "https://github.com/DevTarlow/dsh-response-chime/issues"
  },
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/client.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "notification",
    "sound",
    "chime"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
